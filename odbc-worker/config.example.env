# Kopie nach worker.env (nicht einchecken) und ausfüllen.
# Die Plattform-Basis-URL (ohne abschließenden /).
ACM_BASE_URL=http://192.9.201.9
# Dasselbe Geheimnis wie ODBC_SYNC_TOKEN in der compute-.env der Plattform.
ODBC_SYNC_TOKEN=
# Apollo-Zugang (CONZEPT 16). DSN-Name frei wählbar, muss aber zur
# Python-Architektur passen (32- oder 64-bit-DSN). 64-bit wird empfohlen.
APOLLO_DSN=Apollo 64 Bit
APOLLO_UID=
APOLLO_PWD=
APOLLO_MANDANT=1
