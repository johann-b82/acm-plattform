{
	# TLS folgt in Phase 5 (interne CA). Bis dahin HTTP im LAN.
	auto_https off
	admin off
}

# Der Weg zum Signage-Stack, den Player und Pis nehmen. Siehe die handle-Blöcke
# unten: direkt weiter, nicht über `web`, und mit den Einstellungen, die der
# SSE-Kanal braucht.
(signage_direkt) {
	reverse_proxy {$SIGNAGE_UPSTREAM:host.docker.internal:8080} {
		flush_interval -1
		transport http {
			read_timeout 24h
			write_timeout 24h
			dial_timeout 10s
		}
	}
}

:80 {
	# Nur Fehler loggen — der Access-Log war die Ursache des Platte-voll-Vorfalls.
	log {
		output stdout
		format console
		level ERROR
	}

	# Uploads (ERP-Exporte, Dokumente) bleiben unter 60 MB; alles darüber ist ein Fehler.
	request_body {
		max_size 60MB
	}

	# Die Anzeigen unter /embed/* müssen einrahmbar sein: die Tafeln laufen im
	# eigenen Signage-Stack auf einem eigenen Port, also einem anderen Origin,
	# und SAMEORIGIN ließe den Rahmen im Player leer. Sie bekommen deshalb
	# einen eigenen Satz Kopfzeilen — ohne X-Frame-Options, dafür mit der
	# Herkunftsliste als CSP. Zwei Blöcke statt Löschen im nachgelagerten
	# `handle`: eine Kopfzeile, die weiter oben gesetzt wird, lässt sich weiter
	# unten nicht mehr zuverlässig entfernen (auch `defer` hilft nicht).
	@ohne_anzeigen not path /embed/*
	header @ohne_anzeigen {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Diese Seiten tragen keine Bedienelemente, und ihre Daten hängen am
	# signierten Token — Einrahmen ist hier also kein Hebel. Wer die Herkunft
	# der Tafeln kennt, stellt enger:
	#   EMBED_FRAME_ANCESTORS="'self' http://signage.acm.local:8080"
	header /embed/* {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors {$EMBED_FRAME_ANCESTORS:*}"
		-Server
	}

	# --- Der Player-Weg → Signage-Stack, ohne Umweg über die Plattform.
	#
	# Warum das hier steht, obwohl der Signage-Stack einen eigenen Port hat:
	# Der Player hält sein Gerätetoken im localStorage, und der hängt am
	# Origin. Zeigte ein Pi auf `<host>:8080`, wäre das ein anderer Origin als
	# der, unter dem er gekoppelt wurde — der Speicher wäre leer und jeder
	# Bildschirm zeigte wieder einen Kopplungscode. Unter demselben Origin
	# bleibt die Kopplung erhalten, und die Pis müssen nie angefasst werden.
	#
	# Weitergereicht wird direkt an den Signage-Stack, NICHT über `web`: fällt
	# die Plattform-Anwendung aus, laufen die Tafeln weiter. Nur Caddy selbst
	# liegt dann noch im Weg.
	#
	# `/api/signage/player/stream` ist ein SSE-Kanal, den Player und Sidecar
	# unbegrenzt offenhalten. Ohne `flush_interval -1` puffert Caddy die
	# Ereignisse, ohne die langen Zeitgrenzen kappt es die Verbindung. Das
	# Snippet dazu steht oben, außerhalb des Site-Blocks — dort verlangt Caddy
	# es.
	#
	# Die Oberfläche des Players samt Bündel (`/player/assets/*`).
	handle /player/* {
		import signage_direkt
	}

	# Die Geräte-API: playlist, calibration, heartbeat, stream, asset. Muss VOR
	# /api/signage/* stehen — Caddy wertet handle-Blöcke in Reihenfolge aus.
	handle /api/signage/player/* {
		import signage_direkt
	}

	# Die Kopplung eines neuen Geräts läuft ebenfalls ohne angemeldete Person.
	handle /api/signage/pair/* {
		import signage_direkt
	}

	# --- /api/signage/* → web. Der Route Handler dort hängt das Access-Token an
	# und reicht an den Signage-Stack weiter (eigenes Compose-Projekt, eigener
	# Port). Das ist der Weg der *Verwaltung*, mit Benutzer-Token — die Geräte
	# gehen oben direkt. Muss VOR der allgemeinen /api/*-Regel stehen: Caddy
	# wertet handle-Blöcke in Reihenfolge aus.
	handle /api/signage/* {
		reverse_proxy web:3000
	}

	# --- /api/* → compute (FastAPI). Prefix bleibt erhalten.
	handle /api/* {
		reverse_proxy compute:8000
	}

	# --- /supabase/realtime/* → Kong, ohne Cookies (ADR-0006). Der Browser
	# schickt beim WebSocket-Aufbau alle Cookies mit, darunter das
	# Sitzungs-Cookie mit dem `apps`-Claim; der Realtime-Dienst weist so große
	# Kopfzeilen mit HTTP 431 ab. Er braucht sie nicht: der Schlüssel steht in
	# der Adresse, das Token kommt mit dem Beitritt zum Kanal. Muss VOR der
	# allgemeinen /supabase/*-Regel stehen.
	handle /supabase/realtime/* {
		uri strip_prefix /supabase
		reverse_proxy kong:8000 {
			header_up -Cookie
		}
	}

	# --- /supabase/* → Kong (Auth, PostgREST, Storage). Prefix wird gestrippt,
	# Kong erwartet /auth/v1, /rest/v1, /storage/v1.
	handle_path /supabase/* {
		reverse_proxy kong:8000
	}

	# --- alles andere → Next.js
	handle {
		reverse_proxy web:3000
	}
}
