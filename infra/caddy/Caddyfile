{
	# TLS folgt in Phase 5 (interne CA). Bis dahin HTTP im LAN.
	auto_https off
	admin off
}

:80 {
	# Nur Fehler loggen — der Access-Log war die Ursache des Platte-voll-Vorfalls.
	log {
		output stdout
		format console
		level ERROR
	}

	# Uploads (ERP-Exporte, Dokumente) bleiben unter 60 MB; alles darüber ist ein Fehler.
	request_body {
		max_size 60MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# --- /api/* → compute (FastAPI). Prefix bleibt erhalten.
	handle /api/* {
		reverse_proxy compute:8000
	}

	# --- /supabase/* → Kong (Auth, PostgREST, Storage). Prefix wird gestrippt,
	# Kong erwartet /auth/v1, /rest/v1, /storage/v1.
	handle_path /supabase/* {
		reverse_proxy kong:8000
	}

	# --- alles andere → Next.js
	handle {
		reverse_proxy web:3000
	}
}
