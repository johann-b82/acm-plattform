# ACM-Plattform — Umgebungsvorlage (Phase 2). Werte je Umgebung erzeugen, nie einchecken.
# Supabase-Schlüssel nach offizieller Anleitung generieren (JWT_SECRET → ANON_KEY / SERVICE_ROLE_KEY).

# --- Postgres (Supabase-Image) ---
POSTGRES_PASSWORD=
POSTGRES_DB=acm
POSTGRES_PORT=5432

# --- Supabase ---
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SITE_URL=https://acm.local
API_EXTERNAL_URL=https://acm.local/supabase
SUPABASE_PUBLIC_URL=https://acm.local/supabase
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Upstream-Dienste, die wir nicht betreiben (Log-Volumen, eigene DB):
ENABLE_ANALYTICS=false

# --- Web (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://acm.local/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- compute (FastAPI) ---
COMPUTE_DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@db:5432/acm
SUPABASE_JWKS_URL=http://kong:8000/auth/v1/.well-known/jwks.json
FERNET_KEY=
PERSONIO_CLIENT_ID=
PERSONIO_CLIENT_SECRET=

# --- Embeds für Signage (signierte URLs) ---
EMBED_SIGNING_SECRET=
