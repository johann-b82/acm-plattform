# ACM-Plattform — Umgebungsvorlage. `scripts/init-env.sh` kopiert sie nach .env
# und erzeugt alle Secrets (Supabase utils/generate-keys.sh). Nie einchecken.
#
# Die Supabase-Variablen entsprechen infra/supabase/upstream/.env.example
# (Tag in upstream/UPSTREAM_TAG); beim Upstream-Update dort abgleichen.

############
# Plattform
############
CADDY_HTTP_PORT=80
# Öffentliche Basis-URL, unter der der Browser die Plattform erreicht.
SITE_URL=http://localhost
# Supabase hinter dem Plattform-Caddy (same-origin, Prefix /supabase).
SUPABASE_PUBLIC_URL=http://localhost/supabase
# Issuer der GoTrue-JWTs; compute prüft `iss` dagegen.
API_EXTERNAL_URL=http://localhost/supabase/auth/v1

############
# Secrets (von init-env.sh gesetzt)
############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
MINIO_ROOT_PASSWORD=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

############
# Datenbank
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=acm
POOLER_DB_POOL_SIZE=5

############
# Kong (nur 127.0.0.1, für Studio per SSH-Tunnel)
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# Auth (GoTrue) — Registrierung aus, Nutzer werden eingeladen/angelegt
############
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=ACM-Plattform

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=ACM
STUDIO_DEFAULT_PROJECT=Plattform
OPENAI_API_KEY=

############
# PostgREST
############
PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Storage / sonstiges Upstream
############
GLOBAL_S3_BUCKET=stub
REGION=stub
MINIO_ROOT_USER=supa-storage
STORAGE_TENANT_ID=stub
FUNCTIONS_VERIFY_JWT=false
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=
IMGPROXY_AUTO_WEBP=true
PROXY_DOMAIN=
CERTBOT_EMAIL=

############
# Signage-Stack (eigenes Compose-Projekt, eigener Port)
############
# Vom web-Container aus erreichbar; auf dem Host in der Regel der Caddy-Port
# des Signage-Stacks (SIGNAGE_HTTP_PORT dort).
SIGNAGE_API_URL=http://host.docker.internal:8080

############
# compute (FastAPI)
############
COMPUTE_LOG_LEVEL=warning
